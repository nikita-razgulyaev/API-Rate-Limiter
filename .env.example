# Порт HTTP-сервера
PORT=3000

# Redis / Upstash connection string.
# Оставь пустым — сервер сам переключится в demo-режим (in-memory store),
# работает без единого внешнего сервиса. Задай значение для продакшена
# и распределённого rate limiting между несколькими инстансами сервера.
#
# Пример Upstash:      rediss://default:<password>@<host>:6379
# Пример локального:   redis://localhost:6379
REDIS_URL=
