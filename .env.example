# ───────── Общее ─────────
PORT=3000

# demo  — лендинг + плейграунд + дашборд (публичная демонстрация)
# proxy — боевой режим: reverse proxy перед вашим API с лимитами (нужен UPSTREAM_URL)
MODE=demo

# ───────── Redis ─────────
# Пусто = in-memory (счётчики не общие между инстансами и пропадают при рестарте).
# Для прода задайте Redis 6+/Valkey. rediss:// включает TLS (Upstash и др.).
#   Upstash:  rediss://default:<password>@<host>:6379
#   Локально: redis://localhost:6379
REDIS_URL=
# Таймаут команды Redis, мс. Дольше — считаем хранилище недоступным.
REDIS_TIMEOUT_MS=1000
# Префикс ключей — удобно, если Redis общий с другими сервисами.
KEY_PREFIX=rs

# Что делать, если Redis недоступен:
#   open   — пропускать запросы (доступность важнее), заголовок X-RateLimit-Degraded: 1
#   closed — отвечать 503 (строгость важнее)
FAIL_MODE=open

# ───────── Режим proxy ─────────
# UPSTREAM_URL=http://127.0.0.1:8080
# UPSTREAM_TIMEOUT_MS=30000
# PROXY_PRESERVE_HOST=false
# Файл с правилами (см. rateshield.rules.example.json). SIGHUP перечитывает его без рестарта.
# RULES_FILE=./rateshield.rules.json

# ───────── Безопасность ─────────
# Включает /_rateshield/v1/check, /_rateshield/stats, /_rateshield/rules (Bearer-токен).
# Без токена эти эндпоинты не существуют. Сгенерировать: openssl rand -hex 32
# ADMIN_TOKEN=

# Каким прокси доверять при определении IP клиента (X-Forwarded-For).
# По умолчанию — только локальным/приватным адресам (nginx, Caddy, docker-сеть).
# Значения: число хопов (1), список подсетей, true (доверять всем — только если порт закрыт снаружи), false.
# TRUST_PROXY=

# ───────── Лимиты по умолчанию ─────────
# Для demo — значения плейграунда; для proxy — если RULES_FILE не задан или правило не подошло.
RATE_ALGORITHM=token
RATE_LIMIT=5
RATE_WINDOW=60
